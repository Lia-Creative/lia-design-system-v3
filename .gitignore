# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static
/dist

# Figma push state snapshots — point-in-time recovery only, not source (source is globals.css → tokens.json)
design/themes-default-backup*.json

# Licensed fonts — NEVER commit to this repo. It is PUBLIC.
# Klim (Martina Plantijn, Söhne) are paid licences; the trial `test-*.woff2`
# files carry an even narrower one. Redistributing either via a public repo
# breaches the licence. Canonical copies live in the Lia Vault under
# brand/fonts/ — load them from there, don't vendor them here.
*.woff
*.woff2
*.otf
*.ttf
